# ==============================================================================
# NEXUSDATA AI PLATFORM - ENVIRONMENT CONFIGURATION
# ==============================================================================

# LLM Provider Configuration (Supports OpenAI, Gemini, Anthropic, LiteLLM, Ollama)
LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_REASONING_MODEL=gpt-4o

# Alternative Local / Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Data Engine (DATA-01)
DATABASE_PATH=E:/nexusdata-ai/backend/app/data/sample_dw.duckdb
MAX_QUERY_SCAN_LIMIT_MB=100
ENABLE_HITL_FOR_HIGH_COST=true

# RAG & Vector Engine (AIP-04)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
RERANKER_MODEL=BAAI/bge-reranker-base
DEFAULT_CHUNK_SIZE=512
DEFAULT_CHUNK_OVERLAP=64

# Security & RBAC (Analyst, Admin, RAG_Engineer, Viewer, Builder)
JWT_SECRET_KEY=nexusdata_super_secret_jwt_key_2026_change_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Observability (Optional Langfuse)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
